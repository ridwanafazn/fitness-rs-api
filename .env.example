# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=console
DOCS_ENABLED=true
METRICS_ENABLED=false

# Dataset (relative to the project root or an absolute path)
DATASET_PATH=data/fitness_dataset.csv

# CORS: comma-separated exact origins. "*" keeps the old frontend compatible;
# tighten it once the frontend origin is known.
CORS_ORIGINS=*
ALLOWED_HOSTS=*

# Optional API key. Leave empty for local/demo; set in production.
API_KEY=

# Database (P0.1+). Postgres is recommended; SQLite is local/test only.
# The app converts postgres:// and postgresql:// URLs to psycopg 3.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=
# Local/test convenience. Production must use Alembic.
DB_AUTO_CREATE=false

# OIDC auth and P0.1 profile endpoints. Keep disabled until the provider is ready.
AUTH_ENABLED=false
AUTH_PROFILES_ENABLED=false
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=
AUTH_ALGORITHMS=EdDSA,RS256,ES256
AUTH_JWKS_CACHE_SECONDS=3600
AUTH_LEEWAY_SECONDS=30

# Neon Auth branch URL, e.g. https://ep-xxxx.aws.neon.tech/neondb/auth
# When set, issuer/audience (origin) and JWKS URL are derived automatically.
NEON_AUTH_BASE_URL=

# Local/test only. Never enable in production. Minimum 32 characters.
AUTH_DEV_MODE=false
AUTH_DEV_SECRET=

# Consent policy and account deletion grace period.
CONSENT_POLICY_VERSION=2026-01
ACCOUNT_DELETION_GRACE_DAYS=30

# P0.2 plan lifecycle (requires P0.1 auth/profiles + database).
PLANS_ENABLED=false

# Rate limiting. For multiple instances use a shared Redis URI.
RATE_LIMIT_ENABLED=true
RATE_LIMIT=120/minute
RATE_LIMIT_STORAGE_URI=memory://
# Set true behind Render/Cloud Run; false only for direct local exposure.
TRUST_PROXY_HEADERS=false

# Request hardening
MAX_REQUEST_BYTES=16384
REQUEST_TIMEOUT_SECONDS=15

# Genetic algorithm (production defaults from the thesis tuning)
GA_NUM_GENERATIONS=25
GA_SOL_PER_POP=20
GA_NUM_PARENTS_MATING=8
GA_MUTATION_PERCENT_GENES=12
GA_KEEP_PARENTS=3
GA_STOP_CRITERIA=saturate_8
# Optional fixed seed for reproducible local/research runs.
# GA_RANDOM_SEED=42

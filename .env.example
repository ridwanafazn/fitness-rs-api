# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=console
DOCS_ENABLED=true
METRICS_ENABLED=false

# Dataset (relative to the project root or an absolute path)
DATASET_PATH=data/fitness_dataset.csv

# CORS: comma-separated exact origins. Never use "*" with credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_HOSTS=*

# Optional API key. Leave empty for local/demo; set in production.
API_KEY=

# Rate limiting. For multiple instances use a shared Redis URI.
RATE_LIMIT_ENABLED=true
RATE_LIMIT=30/minute
RATE_LIMIT_STORAGE_URI=memory://
# Only enable behind a trusted proxy (Render/Cloud Run).
TRUST_PROXY_HEADERS=false

# Request hardening
MAX_REQUEST_BYTES=16384
REQUEST_TIMEOUT_SECONDS=15

# Genetic algorithm (production defaults from the thesis tuning)
GA_NUM_GENERATIONS=25
GA_SOL_PER_POP=20
GA_NUM_PARENTS_MATING=8
GA_MUTATION_PERCENT_GENES=12
GA_KEEP_PARENTS=3
GA_STOP_CRITERIA=saturate_8
# Optional fixed seed for reproducible local/research runs.
# GA_RANDOM_SEED=42
